# LLM — 9Router (providers configured in 9Router dashboard)
LLM_ENABLED=true
LLM_BASE_URL=http://host.docker.internal:20128/v1
NINEROUTER_API_KEY=your_key_from_dashboard

# Global Round-Robin Mode (optional)
# If set, models will rotate on each LLM call across all agents.
# You can use a comma-separated list of models OR a predefined combo:
# - ALL: All models in ALLOWED_LLM_MODELS
# - THINKING: All models with "thinking" in their name
# - CLAUDE: All Claude models
# Example: LLM_ROUND_ROBIN=THINKING  OR  LLM_ROUND_ROBIN=kr/glm-5,kr/deepseek-3.2
LLM_ROUND_ROBIN=

LLM_MODEL_DEBATE_R1=gh/gpt-4o-mini
LLM_MODEL_DEBATE_R2=gemini/gemini-2.5-flash
LLM_MODEL_INVESTMENT_MANAGER=gh/gpt-4o
LLM_MODEL_DEBATE_FALLBACK=gemini/gemini-2.0-flash-lite
LLM_MODEL_IM_FALLBACK=gemini/gemini-2.5-pro
LLM_MODEL_DEBATE_R2_FALLBACK=gemini/gemini-2.0-flash-lite
LLM_DEBATE_MAX_TICKERS=12

# Per-agent models (objective debate — different providers per role)
LLM_MODEL_FUNDAMENTAL=kr/glm-5
LLM_MODEL_TECHNICAL=kr/deepseek-3.2
LLM_MODEL_BANDARM=gh/gemini-2.5-pro
LLM_MODEL_MACRO=gh/gpt-4o
LLM_MODEL_FUNDAMENTAL_R2=kr/claude-haiku-4.5-thinking
LLM_MODEL_TECHNICAL_R2=kr/claude-haiku-4.5-thinking
LLM_MODEL_BANDARM_R2=kr/claude-sonnet-4.5-thinking
LLM_MODEL_MACRO_R2=gh/gpt-4o

# Legacy direct APIs (optional)
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_claude_key_here

# Stockbit
STOCKBIT_API_KEY=your_stockbit_key_here
STOCKBIT_USERNAME=your_stockbit_email_or_username
STOCKBIT_PASSWORD=your_stockbit_password
# Optional: jika recaptcha_token expired
STOCKBIT_RECAPTCHA_TOKEN=your_recaptcha_token
STOCKBIT_PLAYER_ID=your_player_id

# News API (NewsAPI.org)
NEWS_API_KEY=your_newsapi_key_here

# PostgreSQL
POSTGRES_DB=stockagent
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=stockpassword
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

ML_AUTO_TRAIN=true
ML_AUTO_TRAIN_PERIOD=1y
ML_AUTO_TRAIN_MIN_ROWS=120
ML_AUTO_TRAIN_MIN_DIR_ACC=50.0
ML_AUTO_TRAIN_FORCE_SAVE=false