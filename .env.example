# LLM — 9Router (providers configured in 9Router dashboard)
LLM_ENABLED=true
LLM_BASE_URL=http://host.docker.internal:20128/v1
NINEROUTER_API_KEY=your_key_from_dashboard

LLM_MODEL_DEBATE_R1=kr/claude-haiku-4.5-agentic
LLM_MODEL_DEBATE_R2=kr/claude-haiku-4.5-thinking-agentic
LLM_MODEL_INVESTMENT_MANAGER=kr/claude-sonnet-4.5-thinking
LLM_MODEL_DEBATE_FALLBACK=gh/claude-haiku-4.5
LLM_MODEL_IM_FALLBACK=gh/claude-opus-4.5
LLM_MODEL_DEBATE_R2_FALLBACK=kr/claude-haiku-4.5-thinking
LLM_DEBATE_MAX_TICKERS=12

# Per-agent models (objective debate — different providers per role)
LLM_MODEL_FUNDAMENTAL=kr/glm-5
LLM_MODEL_TECHNICAL=kr/deepseek-3.2
LLM_MODEL_BANDARM=gh/gemini-2.5-pro
LLM_MODEL_MACRO=gh/gpt-4o
LLM_MODEL_FUNDAMENTAL_R2=kr/claude-haiku-4.5-thinking
LLM_MODEL_TECHNICAL_R2=kr/claude-haiku-4.5-thinking
LLM_MODEL_BANDARM_R2=kr/claude-sonnet-4.5-thinking
LLM_MODEL_MACRO_R2=gh/gpt-4o

# Legacy direct APIs (optional)
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_claude_key_here

# Stockbit
STOCKBIT_API_KEY=your_stockbit_key_here

# PostgreSQL
POSTGRES_DB=stockagent
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=stockpassword
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
